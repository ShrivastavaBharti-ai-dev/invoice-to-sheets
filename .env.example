# Copy this file to .env and fill it in. Never commit .env.
# Free Gemini key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=paste-your-key-here

# Optional: Google Sheet (see integrations/google_apps_script.gs)
SHEETS_WEBHOOK_URL=
SHEETS_TOKEN=

# Optional: protect the API; callers then send this value in the X-API-Key header
APP_API_KEY=

# Optional: choose a different Gemini model
# GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
